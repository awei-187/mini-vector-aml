# Copy to /etc/mini-vector/qwen.env and fill privately.
# Use your existing account/region/workspace OpenAI-compatible embedding base URL.
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_API_KEY_ENV=DASHSCOPE_API_KEY
# DashScope text rerank endpoint for the same account, ending in
# /api/v1/services/rerank/text-rerank/text-rerank
QWEN_RERANK_ENDPOINT=
QWEN_RERANK_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
