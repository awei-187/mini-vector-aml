# Copy to .env in this directory. Fill in the API key for your provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Independent, opt-in rerank_mode="qwen" (never uses OPENAI_CHAT_MODEL).
# Read the existing credential file explicitly, without copying keys here:
# MINI_VECTOR_RERANKER_ENV_FILE=E:\.env
# QWEN_RERANK_MODEL=qwen3-rerank
# QWEN_RERANK_ENDPOINT=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# QWEN_RERANK_API_KEY_ENV=DASHSCOPE_API_KEY
# QWEN_RERANK_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query.

# Optional AML service only: external Qwen configuration file (credentials stay there).
# AML_EMBEDDING_ENV_FILE=E:\.env
# AML_API_TOKEN=replace-with-a-strong-random-service-token
