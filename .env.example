# Chat provider. Fill values privately in .env; never commit that file.
OPENAI_BASE_URL=
OPENAI_API_KEY=
AML_API_TOKEN=
# Set an explicit path on every deployment; historical default E:/.env is Windows-specific.
AML_EMBEDDING_ENV_FILE=/etc/mini-vector/qwen.env
AML_DB_PATH=/var/lib/mini-vector/memory.sqlite3
